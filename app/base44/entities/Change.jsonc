{
  "name": "Change",
  "type": "object",
  "properties": {
    "run_key": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "week": {
      "type": "string"
    },
    "competitor": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "before": {
      "type": "string"
    },
    "after": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "none"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "action": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "deck_line": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "screenshot_url": {
      "type": "string"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "item_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}